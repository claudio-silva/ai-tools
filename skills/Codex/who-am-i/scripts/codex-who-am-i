#!/usr/bin/env python3
"""Report the invoking Codex agent's identity from read-only local evidence."""

from __future__ import annotations

import argparse
import json
import os
import re
import sqlite3
import sys
from pathlib import Path
from typing import Any, Iterable
from urllib.parse import quote

VERSION = "1.0.0"

FIELDS = ("thread_id", "session_id", "model", "reasoning_effort", "model_provider")
IDENTITY_COLUMNS = ("id", "thread_id", "session_id")
FIELD_COLUMNS = {
    "model": ("model", "model_name"),
    "reasoning_effort": ("reasoning_effort", "model_reasoning_effort", "effort"),
    "model_provider": ("model_provider", "provider", "provider_id"),
    "rollout_path": ("rollout_path", "session_path", "rollout_file"),
    "updated": ("updated_at_ms", "updated_at", "recency_at_ms", "recency_at"),
}


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Report the invoking Codex runtime identity as JSON (default) or text."
    )
    parser.add_argument("--human", action="store_true", help="emit human-readable text")
    parser.add_argument(
        "--debug",
        action="store_true",
        help="describe resolution decisions on stderr; never dumps conversation content",
    )
    parser.add_argument(
        "--allow-latest-fallback",
        action="store_true",
        help="if no runtime ID exists, use the latest persisted thread as an explicit low-confidence heuristic",
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    return parser.parse_args()


class DebugLog:
    def __init__(self, enabled: bool) -> None:
        self.enabled = enabled

    def write(self, message: str) -> None:
        if self.enabled:
            print(f"[codex-who-am-i] {message}", file=sys.stderr)


def first_value(mapping: dict[str, Any], names: Iterable[str]) -> Any:
    for name in names:
        value = mapping.get(name)
        if value is not None and value != "":
            return value
    return None


def confidence_rank(value: str) -> int:
    return {"unknown": 0, "low": 1, "medium": 2, "high": 3}.get(value, 0)


def initial_result() -> dict[str, Any]:
    return {
        "thread_id": None,
        "session_id": None,
        "model": None,
        "reasoning_effort": None,
        "model_provider": None,
        "sources": {field: None for field in FIELDS},
        "classification": {field: "unknown" for field in FIELDS},
        "confidence_by_field": {field: "unknown" for field in FIELDS},
        "confidence": "low",
        "explanation": [],
        "evidence": {
            "runtime": None,
            "persisted_thread": None,
            "configured_defaults": None,
        },
    }


def set_field(
    result: dict[str, Any],
    field: str,
    value: Any,
    source: str,
    classification: str,
    confidence: str,
    *,
    replace: bool = False,
) -> None:
    if value is None or value == "":
        return
    current = result["confidence_by_field"].get(field, "unknown")
    if replace or result.get(field) is None or confidence_rank(confidence) > confidence_rank(current):
        result[field] = value
        result["sources"][field] = source
        result["classification"][field] = classification
        result["confidence_by_field"][field] = confidence


def parse_config(path: Path, debug: DebugLog) -> dict[str, Any]:
    if not path.is_file():
        debug.write(f"config not found: {path}")
        return {}
    try:
        try:
            import tomllib  # Python 3.11+

            with path.open("rb") as handle:
                data = tomllib.load(handle)
            return data if isinstance(data, dict) else {}
        except ModuleNotFoundError:
            # Only top-level scalar keys are needed. This fallback intentionally does
            # not attempt to interpret arbitrary TOML or nested credential sections.
            parsed: dict[str, Any] = {}
            in_table = False
            scalar = re.compile(r'^([A-Za-z0-9_-]+)\s*=\s*(["\'])(.*?)\2\s*(?:#.*)?$')
            for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
                stripped = line.strip()
                if stripped.startswith("["):
                    in_table = True
                if in_table:
                    continue
                match = scalar.match(stripped)
                if match:
                    parsed[match.group(1)] = match.group(3)
            return parsed
    except (OSError, ValueError) as exc:
        debug.write(f"could not parse config metadata: {type(exc).__name__}: {exc}")
        return {}


def state_roots(codex_home: Path, config: dict[str, Any], debug: DebugLog) -> list[Path]:
    candidates: list[Path] = []
    env_sqlite_home = os.environ.get("CODEX_SQLITE_HOME")
    if env_sqlite_home:
        candidates.append(Path(env_sqlite_home).expanduser())
        debug.write("honoring CODEX_SQLITE_HOME")
    configured_sqlite_home = config.get("sqlite_home")
    if isinstance(configured_sqlite_home, str) and configured_sqlite_home:
        candidates.append(Path(configured_sqlite_home).expanduser())
        debug.write("found configured sqlite_home")
    candidates.append(codex_home)

    unique: list[Path] = []
    seen: set[str] = set()
    for candidate in candidates:
        key = str(candidate)
        if key not in seen:
            unique.append(candidate)
            seen.add(key)
    return unique


def state_version(path: Path) -> int:
    match = re.fullmatch(r"state_(\d+)\.sqlite", path.name)
    return int(match.group(1)) if match else -1


def find_state_databases(roots: list[Path], debug: DebugLog) -> list[Path]:
    found: list[Path] = []
    seen: set[str] = set()
    for root in roots:
        candidates = [root] if root.is_file() else list(root.glob("state_*.sqlite")) if root.is_dir() else []
        for path in sorted(candidates, key=lambda item: (state_version(item), item.name), reverse=True):
            key = str(path)
            if path.is_file() and key not in seen:
                found.append(path)
                seen.add(key)
    debug.write(f"discovered {len(found)} state database candidate(s)")
    return found


def quote_identifier(value: str) -> str:
    return '"' + value.replace('"', '""') + '"'


def open_readonly(path: Path) -> sqlite3.Connection:
    # URI mode=ro prevents SQLite from creating or modifying the database. It still
    # observes committed WAL content, unlike immutable=1 on a live Codex database.
    uri = f"file:{quote(str(path), safe='/')}?mode=ro"
    connection = sqlite3.connect(uri, uri=True, timeout=2.0)
    connection.row_factory = sqlite3.Row
    connection.execute("PRAGMA query_only = ON")
    return connection


def table_columns(connection: sqlite3.Connection, table: str) -> dict[str, str]:
    rows = connection.execute(f"PRAGMA table_info({quote_identifier(table)})").fetchall()
    return {str(row[1]).lower(): str(row[1]) for row in rows}


def select_column(columns: dict[str, str], aliases: Iterable[str]) -> str | None:
    return first_value(columns, aliases)


def table_score(table: str, columns: dict[str, str]) -> int:
    score = 0
    lower_name = table.lower()
    if "thread" in lower_name or "session" in lower_name:
        score += 5
    if select_column(columns, FIELD_COLUMNS["model"]):
        score += 12
    if select_column(columns, FIELD_COLUMNS["reasoning_effort"]):
        score += 12
    if select_column(columns, FIELD_COLUMNS["model_provider"]):
        score += 6
    if select_column(columns, FIELD_COLUMNS["rollout_path"]):
        score += 6
    return score


def normalized_row(row: sqlite3.Row, aliases: dict[str, str | None]) -> dict[str, Any]:
    output: dict[str, Any] = {}
    row_keys = set(row.keys())
    for field, column in aliases.items():
        output[field] = row[column] if column and column in row_keys else None
    return output


def find_exact_thread(
    databases: list[Path], lookup_id: str, debug: DebugLog
) -> dict[str, Any] | None:
    matches: list[dict[str, Any]] = []
    for database_order, database in enumerate(databases):
        try:
            with open_readonly(database) as connection:
                tables = [
                    str(row[0])
                    for row in connection.execute(
                        "SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name"
                    )
                ]
                for table in tables:
                    columns = table_columns(connection, table)
                    identity = select_column(columns, IDENTITY_COLUMNS)
                    if not identity:
                        continue
                    aliases = {
                        "identity": identity,
                        **{
                            field: select_column(columns, names)
                            for field, names in FIELD_COLUMNS.items()
                        },
                    }
                    if not any(aliases[field] for field in FIELD_COLUMNS):
                        continue
                    selected = [column for column in aliases.values() if column]
                    select_sql = ", ".join(quote_identifier(column) for column in dict.fromkeys(selected))
                    query = (
                        f"SELECT {select_sql} FROM {quote_identifier(table)} "
                        f"WHERE {quote_identifier(identity)} = ? LIMIT 2"
                    )
                    rows = connection.execute(query, (lookup_id,)).fetchall()
                    for row in rows:
                        normalized = normalized_row(row, aliases)
                        normalized.update(
                            {
                                "database": str(database),
                                "table": table,
                                "score": table_score(table, columns),
                                "database_version": state_version(database),
                                "database_order": database_order,
                            }
                        )
                        matches.append(normalized)
        except sqlite3.Error as exc:
            debug.write(f"skipping unreadable state database {database}: {type(exc).__name__}: {exc}")

    if not matches:
        debug.write("no exact persisted thread row matched the runtime ID")
        return None
    # Database order reflects root precedence (explicit SQLite home before
    # CODEX_HOME) and state-file version (newest schema first).
    matches.sort(key=lambda item: (-item["database_order"], item["score"]), reverse=True)
    chosen = matches[0]
    debug.write(f"exact ID matched {chosen['table']} in {chosen['database']}")
    return chosen


def find_latest_thread(databases: list[Path], debug: DebugLog) -> dict[str, Any] | None:
    """Opt-in low-confidence fallback; never part of normal exact correlation."""
    candidates: list[dict[str, Any]] = []
    for database_order, database in enumerate(databases):
        try:
            with open_readonly(database) as connection:
                tables = [
                    str(row[0])
                    for row in connection.execute(
                        "SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name"
                    )
                ]
                for table in tables:
                    columns = table_columns(connection, table)
                    identity = select_column(columns, IDENTITY_COLUMNS)
                    updated = select_column(columns, FIELD_COLUMNS["updated"])
                    if not identity or not updated:
                        continue
                    aliases = {
                        "identity": identity,
                        **{
                            field: select_column(columns, names)
                            for field, names in FIELD_COLUMNS.items()
                        },
                    }
                    if not any(aliases[field] for field in ("model", "reasoning_effort", "model_provider")):
                        continue
                    selected = [column for column in aliases.values() if column]
                    select_sql = ", ".join(quote_identifier(column) for column in dict.fromkeys(selected))
                    row = connection.execute(
                        f"SELECT {select_sql} FROM {quote_identifier(table)} "
                        f"ORDER BY {quote_identifier(updated)} DESC LIMIT 1"
                    ).fetchone()
                    if row:
                        normalized = normalized_row(row, aliases)
                        normalized.update(
                            {
                                "database": str(database),
                                "table": table,
                                "score": table_score(table, columns),
                                "database_version": state_version(database),
                                "database_order": database_order,
                                "updated_value": normalized.get("updated"),
                            }
                        )
                        candidates.append(normalized)
        except sqlite3.Error as exc:
            debug.write(f"latest-thread fallback skipped {database}: {type(exc).__name__}: {exc}")
    if not candidates:
        return None
    candidates.sort(
        key=lambda item: (
            -item["database_order"],
            item.get("updated_value") if isinstance(item.get("updated_value"), (int, float)) else -1,
            item["score"],
        ),
        reverse=True,
    )
    debug.write("using explicitly enabled latest-updated-thread heuristic")
    return candidates[0]


def resolve_rollout_path(
    persisted: dict[str, Any] | None, codex_home: Path, lookup_id: str | None, debug: DebugLog
) -> Path | None:
    if persisted and persisted.get("rollout_path"):
        path = Path(str(persisted["rollout_path"])).expanduser()
        if not path.is_absolute():
            path = Path(str(persisted["database"])).parent / path
        if path.is_file():
            return path
        debug.write(f"persisted rollout path is not a readable file: {path}")
    if lookup_id:
        for base in (codex_home / "sessions", codex_home / "archived_sessions"):
            if not base.is_dir():
                continue
            matches = list(base.rglob(f"*{lookup_id}*.jsonl"))
            if len(matches) == 1:
                debug.write("located rollout by exact ID in its filename")
                return matches[0]
            if len(matches) > 1:
                debug.write("multiple rollout filenames matched the exact ID; refusing ambiguity")
    return None


def inspect_rollout(path: Path, lookup_id: str, debug: DebugLog) -> dict[str, Any] | None:
    session_meta: dict[str, Any] | None = None
    contexts: list[dict[str, Any]] = []
    active_turns: set[str] = set()
    malformed = 0
    try:
        with path.open("r", encoding="utf-8", errors="replace") as handle:
            for line in handle:
                try:
                    item = json.loads(line)
                except (json.JSONDecodeError, TypeError):
                    malformed += 1
                    continue
                item_type = item.get("type")
                payload = item.get("payload")
                if not isinstance(payload, dict):
                    continue
                if item_type == "session_meta":
                    candidate_id = first_value(payload, ("id", "session_id", "thread_id"))
                    if candidate_id == lookup_id:
                        session_meta = payload
                elif item_type == "turn_context":
                    contexts.append(payload)
                elif item_type == "event_msg":
                    turn_id = payload.get("turn_id")
                    if not isinstance(turn_id, str):
                        continue
                    if payload.get("type") == "task_started":
                        active_turns.add(turn_id)
                    elif payload.get("type") in {"task_complete", "task_completed", "task_cancelled"}:
                        active_turns.discard(turn_id)
    except OSError as exc:
        debug.write(f"could not read rollout metadata: {type(exc).__name__}: {exc}")
        return None

    if malformed:
        debug.write(f"ignored {malformed} malformed rollout record(s)")
    if session_meta is None:
        debug.write("rollout session metadata did not match the exact runtime ID")
        return None
    active_contexts = [context for context in contexts if context.get("turn_id") in active_turns]
    context = active_contexts[-1] if active_contexts else contexts[-1] if contexts else None
    if active_contexts:
        debug.write("found turn_context for an active turn")
    elif context:
        debug.write("found latest turn_context, but no active-turn marker")
    return {
        "path": str(path),
        "session_id": first_value(session_meta, ("session_id", "id", "thread_id")),
        "model_provider": session_meta.get("model_provider"),
        "turn_id": context.get("turn_id") if context else None,
        "model": context.get("model") if context else None,
        "reasoning_effort": first_value(context or {}, ("reasoning_effort", "effort")),
        "active_turn": bool(active_contexts),
    }


def apply_persisted(result: dict[str, Any], row: dict[str, Any], *, heuristic: bool) -> None:
    classification = "heuristic-fallback" if heuristic else "persisted-thread-value"
    confidence = "low" if heuristic else "medium"
    source_base = f"{row['database']}:{row['table']}"
    if heuristic:
        source_base += " (latest-updated heuristic; not exact current-thread correlation)"
        set_field(result, "thread_id", row.get("identity"), source_base, classification, confidence)
        set_field(result, "session_id", row.get("identity"), source_base, classification, confidence)
    for field in ("model", "reasoning_effort", "model_provider"):
        set_field(result, field, row.get(field), source_base, classification, confidence)
    result["evidence"]["persisted_thread"] = {
        "database": row["database"],
        "table": row["table"],
        "matched_id": row.get("identity"),
        "model": row.get("model"),
        "reasoning_effort": row.get("reasoning_effort"),
        "model_provider": row.get("model_provider"),
        "correlation": "latest-updated-heuristic" if heuristic else "exact-runtime-id",
    }


def apply_rollout(result: dict[str, Any], rollout: dict[str, Any]) -> None:
    source_base = f"{rollout['path']}:turn_context"
    confidence = "high" if rollout["active_turn"] else "medium"
    set_field(
        result,
        "model",
        rollout.get("model"),
        source_base,
        "effective-runtime-value" if rollout["active_turn"] else "persisted-turn-value",
        confidence,
        replace=rollout["active_turn"],
    )
    set_field(
        result,
        "reasoning_effort",
        rollout.get("reasoning_effort"),
        source_base,
        "effective-runtime-value" if rollout["active_turn"] else "persisted-turn-value",
        confidence,
        replace=rollout["active_turn"],
    )
    set_field(
        result,
        "model_provider",
        rollout.get("model_provider"),
        f"{rollout['path']}:session_meta",
        "effective-session-value",
        "high",
        replace=True,
    )
    result["evidence"]["runtime"] = {
        "rollout_path": rollout["path"],
        "turn_id": rollout.get("turn_id"),
        "active_turn": rollout["active_turn"],
        "model": rollout.get("model"),
        "reasoning_effort": rollout.get("reasoning_effort"),
        "model_provider": rollout.get("model_provider"),
    }


def apply_config_defaults(result: dict[str, Any], config: dict[str, Any], path: Path) -> None:
    values = {
        "model": first_value(config, ("model",)),
        "reasoning_effort": first_value(config, ("model_reasoning_effort", "reasoning_effort")),
        "model_provider": first_value(config, ("model_provider",)),
    }
    if not any(value is not None for value in values.values()):
        return
    for field, value in values.items():
        set_field(
            result,
            field,
            value,
            f"{path} (configured default; not proof of current runtime)",
            "configured-default",
            "low",
        )
    result["evidence"]["configured_defaults"] = {"path": str(path), **values}


def compare_evidence(result: dict[str, Any]) -> None:
    runtime = result["evidence"].get("runtime") or {}
    persisted = result["evidence"].get("persisted_thread") or {}
    configured = result["evidence"].get("configured_defaults") or {}
    for field in ("model", "reasoning_effort", "model_provider"):
        runtime_value = runtime.get(field)
        persisted_value = persisted.get(field)
        configured_value = configured.get(field)
        if runtime_value is not None and persisted_value is not None and runtime_value != persisted_value:
            result["explanation"].append(
                f"Runtime {field} differs from persisted thread metadata; runtime evidence takes precedence."
            )
        if result.get(field) is not None and configured_value is not None and result[field] != configured_value:
            result["explanation"].append(
                f"Resolved {field} differs from config.toml; the config value is only a default."
            )


def calculate_overall_confidence(result: dict[str, Any]) -> None:
    relevant = [
        result["confidence_by_field"][field]
        for field in ("thread_id", "model", "reasoning_effort")
        if result.get(field) is not None
    ]
    if not relevant:
        result["confidence"] = "low"
    elif all(value == "high" for value in relevant):
        result["confidence"] = "high"
    elif any(value == "low" for value in relevant):
        result["confidence"] = "low"
    else:
        result["confidence"] = "medium"


def resolve_identity(args: argparse.Namespace, debug: DebugLog) -> dict[str, Any]:
    result = initial_result()
    codex_home = Path(os.environ.get("CODEX_HOME") or (Path.home() / ".codex")).expanduser()
    config_path = codex_home / "config.toml"
    config = parse_config(config_path, debug)

    env_thread_id = os.environ.get("CODEX_THREAD_ID") or None
    env_session_id = os.environ.get("CODEX_SESSION_ID") or None
    if env_thread_id:
        set_field(
            result,
            "thread_id",
            env_thread_id,
            "environment:CODEX_THREAD_ID",
            "effective-runtime-value",
            "medium",
        )
        debug.write("found CODEX_THREAD_ID")
    if env_session_id:
        set_field(
            result,
            "session_id",
            env_session_id,
            "environment:CODEX_SESSION_ID",
            "effective-runtime-value",
            "medium",
        )
        debug.write("found CODEX_SESSION_ID")
    if env_thread_id and env_session_id and env_thread_id != env_session_id:
        result["explanation"].append(
            "CODEX_THREAD_ID and CODEX_SESSION_ID differ; thread correlation uses CODEX_THREAD_ID."
        )

    lookup_id = env_thread_id or env_session_id
    roots = state_roots(codex_home, config, debug)
    databases = find_state_databases(roots, debug)
    persisted = find_exact_thread(databases, lookup_id, debug) if lookup_id else None
    heuristic = False
    if persisted is None and lookup_id is None and args.allow_latest_fallback:
        persisted = find_latest_thread(databases, debug)
        heuristic = persisted is not None
        if heuristic:
            lookup_id = str(persisted.get("identity") or "") or None
            result["explanation"].append(
                "No runtime thread ID was available; latest-updated-thread correlation was explicitly enabled and is low confidence."
            )
    elif lookup_id is None:
        result["explanation"].append(
            "No CODEX_THREAD_ID or CODEX_SESSION_ID was available; current-thread correlation was not attempted."
        )

    if persisted:
        apply_persisted(result, persisted, heuristic=heuristic)
        if not heuristic:
            if env_thread_id and persisted.get("identity") == env_thread_id:
                set_field(
                    result,
                    "thread_id",
                    env_thread_id,
                    f"environment:CODEX_THREAD_ID (exactly validated by {persisted['database']}:{persisted['table']})",
                    "effective-runtime-value",
                    "high",
                    replace=True,
                )
            elif env_thread_id is None and env_session_id and persisted.get("identity") == env_session_id:
                set_field(
                    result,
                    "thread_id",
                    persisted.get("identity"),
                    f"environment:CODEX_SESSION_ID (exactly matched {persisted['database']}:{persisted['table']})",
                    "effective-runtime-value",
                    "high",
                )

    rollout_path = resolve_rollout_path(persisted, codex_home, lookup_id, debug)
    if rollout_path and lookup_id and not heuristic:
        rollout = inspect_rollout(rollout_path, lookup_id, debug)
        if rollout:
            apply_rollout(result, rollout)
            rollout_session_id = rollout.get("session_id")
            if result["session_id"] is None or result["session_id"] == rollout_session_id:
                set_field(
                    result,
                    "session_id",
                    rollout_session_id,
                    f"{rollout_path}:session_meta",
                    "effective-session-value",
                    "high",
                    replace=result["session_id"] == rollout_session_id,
                )

    apply_config_defaults(result, config, config_path)
    compare_evidence(result)
    calculate_overall_confidence(result)
    return result


def human_value(value: Any) -> str:
    return str(value) if value is not None else "unknown"


def print_human(result: dict[str, Any]) -> None:
    print("Codex runtime identity")
    print()
    print(f"Thread:            {human_value(result['thread_id'])}")
    print(f"Session:           {human_value(result['session_id'])}")
    print(f"Model:             {human_value(result['model'])}")
    print(f"Reasoning effort:  {human_value(result['reasoning_effort'])}")
    print(f"Provider:          {human_value(result['model_provider'])}")
    print()
    for label, field in (
        ("Thread", "thread_id"),
        ("Model", "model"),
        ("Reasoning", "reasoning_effort"),
        ("Provider", "model_provider"),
    ):
        print(f"{label} classification: {result['classification'][field]}")
        print(f"{label} source:         {human_value(result['sources'][field])}")
    print(f"Confidence:         {result['confidence']}")
    if result["explanation"]:
        print()
        print("Notes:")
        for note in result["explanation"]:
            print(f"- {note}")


def main() -> int:
    args = parse_args()
    debug = DebugLog(args.debug)
    try:
        result = resolve_identity(args, debug)
        if args.human:
            print_human(result)
        else:
            json.dump(result, sys.stdout, indent=2, sort_keys=False)
            sys.stdout.write("\n")
        return 0
    except (OSError, sqlite3.Error) as exc:
        error = {
            "error": type(exc).__name__,
            "message": str(exc),
            "partial_identity_available": False,
        }
        if args.human:
            print(f"codex-who-am-i failed: {type(exc).__name__}: {exc}", file=sys.stderr)
        else:
            json.dump(error, sys.stdout, indent=2)
            sys.stdout.write("\n")
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
