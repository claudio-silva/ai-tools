def cmd_batch(lines, keep_going=False):
    """Run one command per line: 'click Sign in', 'type Username john', ...
    `#` comments and blanks allowed. Stops on first failure unless
    --keep-going. All lines share the current --ctx."""
    import shlex
    rc = 0
    for i, line in enumerate(lines, 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        print("### %s" % line)
        try:
            dispatch(shlex.split(line))
        except SystemExit as e:
            if e.code:
                rc = e.code if isinstance(e.code, int) else 1
                if not keep_going:
                    fail("batch aborted at line %d" % i)
        except Exception as e:
            rc = 1
            print("ERROR %s" % e)
            if not keep_going:
                fail("batch aborted at line %d" % i)
    if rc:
        sys.exit(rc)


def cmd_status():
    for name, c in (STATE.get("contexts") or {}).items():
        print("ctx=%s pid=%s alive=%s owned=%s url=%s" % (
            name, c.get("prepared_pid"), alive(c), c.get("owned"), c.get("url")))


def cmd_close(names, all_=False):
    """Close given ctx names (or --ctx, or all). end_session kills only the
    instances prepared under each ctx's own session label — attached
    (owned:false) browsers are never terminated."""
    global CTX
    st = STATE
    if all_:
        names = list(st["contexts"].keys())
    elif not names:
        names = [CTX]
    for n in names:
        c = st["contexts"].get(n)
        if not c:
            print("ctx %s: unknown" % n)
            continue
        CTX = n
        if c.get("owned"):
            d, raw = cli("end_session",
                         {"session": c.get("session") or session_label()})
            print("ctx %s: end_session -> %s" % (n, json.dumps(d or raw)[:200]))
        else:
            print("ctx %s: attached browser left running; state dropped" % n)
        st["contexts"].pop(n, None)
        DELETED.add(n)
    save_state(st)


USAGE = __doc__ + """
Commands (all take --ctx NAME):
  new-context [LABEL]       FIRST CALL. Verifies cua-driver exists, allocates a
                            unique context name, prints it. Pass it as --ctx on
                            every later call; never clashes across agents/IDEs.
  open URL [--profile P] [--wait-for T]   launch/reuse isolated browser, navigate, snapshot
  attach --pid P --window-id W   bind an existing (CDP-ready) browser window
  snap [--full] [--query T] [--scope REF] [--more TOKEN]
                            compact actionable-ref table (fresh every time);
                            --more continues a TRUNCATED snapshot, --scope
                            reads one subtree only
  find TEXT                 semantic search over role/name/visible text
  click TARGET [--wait-for T]   p<i>:<j> | css=SEL | accessible-name text
  type TARGET TEXT [--replace] [--keystrokes] [--wait-for T]
                            insert at caret (default appends; --replace selects
                            all first = set value; empty TEXT + --replace clears).
                            --keystrokes = per-char key events for picky fields.
  press KEY [TARGET]        real key event: enter|tab|escape|backspace|delete|
                            space (enter submits forms, tab moves focus)
  batch [FILE|--keep-going] run one command per line from FILE or stdin —
                            'click Sign in', 'type User john', ... Fewer
                            roundtrips; lines may carry their own --ctx.
  tree                      concise semantic outline (AX+DOM text tree)
  files TARGET PATH...      set <input type=file> to absolute local files
  hover|right-click|double-click TARGET ; scroll DY [TARGET] ; drag TARGET TO
  shot [PATH] [--full]      tab-viewport PNG -> file; prints px->css scale.
                            --full captures the whole page (CDP
                            captureBeyondViewport), not just the viewport
  text                      rendered page text (page get_text)
  read TARGET               one element's role/name/value/states (extract a
                            generated code or field value)
  copy [TARGET]             page text or element value -> macOS clipboard,
                            verified (the sanctioned copy path)
  download TARGET DIR       save what TARGET links to into exact DIR (gated;
                            may need host approval)
  dom CSS                   CSS existence check (read-only)
  cdp                       print the instance's DevTools http + browser/page
                            WS endpoints — raw CDP or playwright
                            connectOverCDP (escape hatch when `eval` is gated)
  eval JS|@FILE             JS in the page's MAIN world (page internals, not
                            a sandboxed view): driver execute_javascript
                            first, transparent Runtime.evaluate fallback on
                            refusal. @FILE reads JS from disk.
  wait-for TEXT [--timeout S]   poll until text appears
  dialog inspect|accept|dismiss [--text T]
  tabs / tab SEL            list tabs; select active (index|tab_id|url-substr)
  resize W H                set outer window frame (responsive checks)
  record start|stop|state   evidence: per-action before/after PNG + json;
                            --video adds recording.mp4 (macOS ScreenCaptureKit)
  url                       current URL/title
  status                    all known contexts: pid, alive, url
  close [CTX ...] | --all   end_session kills owned instance(s); --all also
                            closes OTHER agents' contexts - prefer your own names
"""


def dispatch(argv):
    """One command line worth of args (also used per-line by `batch`)."""
    global CTX
    argv = list(argv)
    def flag(name, takes=True):
        nonlocal argv
        if name in argv:
            i = argv.index(name)
            v = argv[i + 1] if takes else True
            del argv[i:i + (2 if takes else 1)]
            return v
        return None
    c = flag("--ctx")
    if c:
        CTX = c
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return
    cmd, args = argv[0], argv[1:]
    rep = flag("--replace", takes=False)
    prof = flag("--profile")
    to = flag("--timeout")
    ptext = flag("--text")
    full = flag("--full", takes=False)
    q = flag("--query")
    wf = flag("--wait-for")
    if cmd == "new-context":
        cmd_new_context(args[0] if args else None)
    elif cmd == "open":
        cmd_open(args[0], profile=prof, wait=wf)
    elif cmd == "attach":
        cmd_attach(flag("--pid"), flag("--window-id"))
    elif cmd == "snap":
        mr = flag("--more")
        sc = flag("--scope")
        cmd_snap(full=full, query=q, more=mr, scope=sc)
    elif cmd == "find":
        cmd_find(args[0])
    elif cmd == "click":
        cmd_click(args[0], wait=wf)
    elif cmd == "type":
        ks = flag("--keystrokes", takes=False)
        cmd_type(args[0], " ".join(args[1:]), replace=bool(rep), wait=wf,
                 keystrokes=bool(ks))
    elif cmd == "press":
        cmd_press(args[0], target=args[1] if len(args) > 1 else None)
    elif cmd == "tree":
        cmd_tree()
    elif cmd == "batch":
        kg = flag("--keep-going", takes=False)
        src = open(args[0]).read() if args else sys.stdin.read()
        cmd_batch(src.splitlines(), keep_going=bool(kg))
    elif cmd == "files":
        cmd_files(args[0], args[1:])
    elif cmd in ("hover", "right-click", "double-click"):
        cmd_pointer({"hover": "hover", "right-click": "right_click",
                     "double-click": "double_click"}[cmd], target=args[0])
    elif cmd == "scroll":
        cmd_pointer("scroll", target=args[1] if len(args) > 1 else None,
                    dy=args[0])
    elif cmd == "drag":
        cmd_pointer("drag", target=args[0], to=args[1])
    elif cmd == "shot":
        cmd_shot(args[0] if args else None, full=bool(full))
    elif cmd == "text":
        cmd_text()
    elif cmd == "dom":
        cmd_dom(args[0])
    elif cmd == "read":
        cmd_read(args[0])
    elif cmd == "cdp":
        cmd_cdp()
    elif cmd == "copy":
        cmd_copy(args[0] if args else None)
    elif cmd == "download":
        cmd_download(args[0], args[1])
    elif cmd == "eval":
        cmd_eval(" ".join(args))
    elif cmd == "wait-for":
        cmd_waitfor(args[0], timeout=float(to or 15))
    elif cmd == "dialog":
        cmd_dialog(args[0], text=ptext)
    elif cmd == "tabs":
        cmd_tabs()
    elif cmd == "tab":
        cmd_tab(args[0])
    elif cmd == "resize":
        cmd_resize(args[0], args[1])
    elif cmd == "record":
        vid = flag("--video", takes=False)
        cmd_record(args[0], outdir=args[1] if len(args) > 1 else None,
                   video=bool(vid))
    elif cmd == "url":
        c2 = ctx(STATE)
        d = snap(c2)
        pg = d.get("page") or {}
        print("%s | %s" % (pg.get("url"), pg.get("title")))
    elif cmd == "status":
        cmd_status()
    elif cmd == "close":
        all_ = "--all" in args
        cmd_close([a for a in args if a != "--all"], all_=all_)
    else:
        print(USAGE)
        sys.exit(2)


STATE = None
if __name__ == "__main__":
    for i, a in enumerate(sys.argv):
        if a == "--ctx" and i + 1 < len(sys.argv):
            CTX = sys.argv[i + 1]
    STATE = load_state()
    if len(sys.argv) < 2:
        print(USAGE)
        sys.exit(2)
    dispatch(sys.argv[1:])
