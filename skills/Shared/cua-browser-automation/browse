#!/usr/bin/env python3
"""browse — thin, stateful wrapper over the cua-driver CLI browser lane.

Usage:  browse [--run NAME] <command> [args] [--ctx NAME]

One named context (--ctx, default "main") = one isolated driver-owned browser
instance (own pid, window, target_id, driver session). Parallel tests use
multiple contexts:  browse --ctx a open URL ; browse --ctx b open URL.
Page-opened extra tabs inside a context are handled by `tabs` / `tab`.

State lives in ${TMPDIR}/cua-browse/<run>.json so each invocation is one
shell call with no plumbing exposed. Low-level rationale lives in NOTES.md.
Stdlib only; requires `cua-driver` on PATH.
"""

import json, os, re, shutil, socket, struct, subprocess, sys, time, urllib.request, uuid
from base64 import b64decode, b64encode

CTX = "main"
BROWSER_BUNDLES = ("chrome", "chromium", "edge", "brave")
EDIT_ROLES = ("textbox", "searchbox", "combobox", "spinbutton", "editable")
DELETED = set()  # ctx names removed this process — save_state must not resurrect


def state_path():
    d = os.path.join(os.environ.get("TMPDIR", "/tmp"), "cua-browse")
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, "state.json")


def load_state():
    try:
        return json.load(open(state_path()))
    except Exception:
        return {"contexts": {}}


def save_state(st):
    """Merge into the on-disk state so concurrent agents (separate processes,
    separate ctx names) never clobber each other. Atomic via os.replace."""
    disk = load_state()
    disk.setdefault("contexts", {}).update(st.get("contexts", {}))
    for n in DELETED:
        disk["contexts"].pop(n, None)
    tmp = state_path() + ".tmp.%d" % os.getpid()
    json.dump(disk, open(tmp, "w"), indent=1)
    os.replace(tmp, state_path())


_DAEMON_TRIED = False
LAST_D = {}  # most recent snapshot dict (per-process; read/copy reuse it)


def cli(tool, args, timeout=30):
    """One cua-driver call. Returns (parsed-json-or-None, raw-text).
    Self-heals a dead daemon: on socket failure, starts `serve` once and
    retries — so no MCP server or manual daemon management is needed."""
    global _DAEMON_TRIED
    args = dict(args)
    args.setdefault("session", session_label())
    for attempt in range(2):
        p = subprocess.run(["cua-driver", tool, json.dumps(args)],
                           capture_output=True, text=True, timeout=timeout)
        out = (p.stdout or "") + (p.stderr or "")
        dead = "not running" in out or "connect" in out.lower() and "sock" in out.lower()
        if dead and not _DAEMON_TRIED:
            _DAEMON_TRIED = True
            subprocess.Popen(["cua-driver", "serve", "--no-permissions-gate"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            time.sleep(3)
            continue
        break
    try:
        return json.loads(out), out
    except Exception:
        return None, out.strip()


def session_label():
    return "browse-" + CTX


def fail(msg, extra=None, code=1):
    print("FAIL " + msg)
    if extra:
        print(str(extra)[:2000])
    sys.exit(code)


def ctx(st, need=True):
    c = st["contexts"].get(CTX)
    if not c and need:
        fail("no context '%s' — get one with: browse new-context" % CTX)
    return c


def alive(c):
    pid = c.get("prepared_pid")
    if not pid:
        return bool(c.get("target_id"))
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def find_browser_pid():
    d, raw = cli("list_apps", {"kind": "desktop"})
    apps = (d or {}).get("apps") or []
    for a in apps:
        if any(b in json.dumps(a).lower() for b in BROWSER_BUNDLES) and a.get("pid"):
            return a["pid"]
    return None


def pick_window(pid):
    d, raw = cli("list_windows", {"pid": pid, "on_screen_only": True})
    for w in (d or {}).get("windows", []):
        if w.get("title") in ("about:blank", "") or True:
            return w  # on_screen_only already filters; first wins
    return None


def ensure_ctx(st, profile=None):
    """Prepare + bind an isolated instance for CTX if missing/dead."""
    c = st["contexts"].get(CTX)
    if c and alive(c) and c.get("target_id"):
        return c
    label = (c or {}).get("session") or session_label()
    pid = find_browser_pid()
    if not pid:
        fail("no supported browser running (chrome/chromium/edge/brave) — "
             "start one so browser_prepare can clone the product")
    prof = {"mode": "isolated_new"}
    if profile:
        prof = {"mode": "isolated_named", "name": profile}
    d, raw = cli("browser_prepare",
                 {"pid": pid, "allow_launch": True, "profile": prof})
    ppid = (d or {}).get("prepared_pid")
    if not ppid:
        fail("browser_prepare refused", raw)
    win = None
    for _ in range(20):  # instance takes a moment to map its window
        win = pick_window(ppid)
        if win:
            break
        time.sleep(0.5)
    if not win:
        fail("isolated browser pid %s has no on-screen window" % ppid)
    d, raw = cli("get_browser_state",
                 {"pid": ppid, "window_id": win["window_id"], "session": label})
    tabs = (d or {}).get("tabs") or []
    if not (d and d.get("target_id") and tabs):
        fail("bind failed", raw)
    c = {"session": label, "owned": True, "prepared_pid": ppid,
         "window_id": win["window_id"], "target_id": d["target_id"],
         "tabs": tabs, "active_tab": tabs[0]["tab_id"],
         "last_snap": None, "url": "about:blank", "title": ""}
    st["contexts"][CTX] = c
    save_state(st)
    return c


def wait_for(c, text, timeout):
    t0 = time.time()
    while time.time() - t0 < timeout:
        d = snap(c, query=text)
        if d.get("content_refs") or any(
                text.lower() in (r.get("name") or "").lower()
                for r in d.get("refs") or []):
            return d
        time.sleep(0.7)
    return None


def cmd_new_context(label=None):
    """Existence test + unique ctx allocation. Prints the ctx name.

    Agents call this first: it fails (with the install hint) when cua-driver
    is absent, and returns a name no other agent/harness on this machine can
    collide with. Pass it to every later call as --ctx NAME."""
    if not shutil.which("cua-driver"):
        fail("cua-driver not found — install it: https://cua.ai/docs/cua-driver "
             "(do not substitute other browser tooling)")
    base = re.sub(r"[^a-z0-9-]", "", (label or "ctx").lower()) or "ctx"
    name = "%s-%s" % (base, uuid.uuid4().hex[:6])
    while name in STATE["contexts"]:
        name = "%s-%s" % (base, uuid.uuid4().hex[:6])
    global CTX
    CTX = name
    STATE["contexts"][name] = {"session": session_label(), "owned": True}
    save_state(STATE)
    print(name)


def snap(c, shot=False, query=None, cont=None, scope=None):
    """Fresh semantic_v2 snapshot; updates ctx bookkeeping. Returns parsed dict."""
    a = {"target_id": c["target_id"], "tab_id": c["active_tab"],
         "snapshot_format": "semantic_v2"}
    if shot:
        a["include_screenshot"] = True
    if query:
        a["query"] = query
    if cont:
        a["continuation"] = cont
    if scope:
        a["scope_ref"] = scope
    d, raw = cli("get_browser_state", a, timeout=45)
    if not d or d.get("status") == "refused" or not d.get("snapshot"):
        fail("snapshot failed", raw)
    if not cont:
        c["last_snap"] = (d.get("snapshot") or {}).get("id")
        pg = d.get("page") or {}
        c["url"], c["title"] = pg.get("url"), pg.get("title")
        save_state(STATE)
    LAST_D.clear()
    LAST_D.update(d)  # resolve/read/copy reuse it within this process
    return d


def brief(d, limit=40):
    """Compact actionable-ref table."""
    pg = d.get("page") or {}
    print("%s | %s | snap %s" % (pg.get("url"), pg.get("title"),
                                (d.get("snapshot") or {}).get("id")))
    for r in (d.get("refs") or [])[:limit]:
        nm = (r.get("name") or r.get("value") or "")[:90].replace("\n", " ")
        print("%-7s %-12s %-90s %s" % (
            r.get("ref"), r.get("role"), nm,
            ",".join(r.get("actions") or [])))
    n = len(d.get("refs") or [])
    if n > limit:
        print("... %d more refs (browse snap --full for all)" % (n - limit))


def resolve(c, target, want):
    """TARGET -> a fresh p-ref. Always re-snapshots so nothing is stale.

    Resolution order: explicit p<i>:<j> ref (prefix must match the fresh
    snapshot), css=SELECTOR (via query_dom -> accessible name -> semantic
    match), else case-insensitive accessible-name match over refs that
    advertise `want` capability. Exits 2 with a candidate list on ambiguity.
    """
    d = snap(c)
    sid = (d.get("snapshot") or {}).get("id")
    refs = d.get("refs") or []
    m = re.fullmatch(r"p\d+:\d+", target or "")
    if m:
        if not target.startswith(sid + ":"):
            fail("ref %s is from an older snapshot (current %s) — re-resolve by name"
                 % (target, sid))
        return target
    if target.startswith("css="):
        sel = target[4:]
        _, raw = cli("page", {"action": "query_dom", "pid": c["prepared_pid"],
                              "window_id": c["window_id"], "css_selector": sel})
        names = re.findall(r'AX\w+ ?\(?"?([^()\n"]+)"?\)?', raw or "")
        names += re.findall(r'"([^"\n]+)"', raw or "")
        if not names:
            fail("no DOM match for %s" % sel, raw)
        target = names[0].strip()  # fall through to semantic match
        print("css %s -> '%s'" % (sel, target))
    def capable(r):
        a = r.get("actions") or []
        role = (r.get("role") or "").lower()
        if want == "click":
            return "click" in a
        if want == "type":
            return "type" in a or role in EDIT_ROLES
        if want == "pointer":
            return "pointer" in a or "scroll" in a
        if want == "upload":
            return "upload" in a
        return True
    cand = [r for r in refs if capable(r)]
    t = target.lower()
    def score(r):
        n = (r.get("name") or r.get("value") or "").lower()
        if n == t:
            s = 0
        elif n.startswith(t):
            s = 1
        elif t in n:
            s = 2
        else:
            return None
        if r.get("visibility") != "in_viewport":
            s += 3
        return s
    scored = sorted(((score(r), r) for r in cand), key=lambda x: x[0] if x[0] is not None else 9)
    scored = [(s, r) for s, r in scored if s is not None]
    if not scored:
        if want == "type" and len(cand) == 1:
            return cand[0]["ref"]  # single editable on page — intent unambiguous
        if want == "type" and cand:
            print("AMBIGUOUS '%s' — %d editable elements, use a ref:" % (target, len(cand)))
            for r in cand:
                print("  %s %s name=%s value=%s" % (r.get("ref"), r.get("role"),
                      r.get("name"), r.get("value")))
            sys.exit(2)
        fail("no %s-able element matching '%s' — browse snap to see refs"
             % (want, target))
    best = scored[0][0]
    top = [r for s, r in scored if s == best]
    if len(top) > 1:
        print("AMBIGUOUS '%s' — %d matches, refine or use a ref:" % (target, len(top)))
        for r in top:
            print("  %s %s '%s'" % (r.get("ref"), r.get("role"), r.get("name")))
        sys.exit(2)
    return top[0]["ref"]


def click_like(tool_args, c, wait=None):
    """Trusted first; on route_unavailable retry dom_event; verify by resnap."""
    before = c.get("url")
    d, raw = cli("browser_click", tool_args)
    eff = (d or {}).get("effect")
    if eff == "refused" and ((d or {}).get("escalation") or {}).get("reason") == "route_unavailable":
        tool_args["input_route"] = "dom_event"
        d, raw = cli("browser_click", tool_args)
        eff = (d or {}).get("effect")
    if eff == "refused":
        fail("click refused", raw)
    print("click: effect=%s route=%s" % (eff, (d or {}).get("route")))
    d2 = wait_for(c, wait, 15) if wait else snap(c)
    if wait and d2 is None:
        fail("click delivered but '%s' did not appear within 15s" % wait)
    pg = d2.get("page") or {}
    now = pg.get("url")
    if now != before:
        print("navigated -> %s" % now)
    else:
        print("same page: %s | refs=%d" % (now, len(d2.get("refs") or [])))


def base(c):
    return {"target_id": c["target_id"], "tab_id": c["active_tab"]}


# ---------------- commands ----------------

def cmd_open(url, profile=None, wait=None):
    st = STATE
    c = ensure_ctx(st, profile)
    if not re.match(r"^(https?://|about:)", url):
        fail("navigate is http(s):// or about: only — got '%s'" % url)
    d, raw = cli("browser_navigate", dict(base(c), url=url))
    if (d or {}).get("status") not in ("ok", None) and not (d or {}).get("url"):
        fail("navigate failed", raw)
    time.sleep(0.6)  # let the committed navigation paint
    d2 = wait_for(c, wait, 15) if wait else snap(c)
    if wait and d2 is None:
        fail("page loaded but '%s' did not appear within 15s" % wait)
    brief(d2)


def cmd_attach(pid, window_id):
    d, raw = cli("browser_prepare", {"pid": int(pid)})  # detect-only, no side effects
    d2, raw2 = cli("get_browser_state",
                   {"pid": int(pid), "window_id": int(window_id)})
    tabs = (d2 or {}).get("tabs") or []
    if not (d2 and d2.get("target_id") and tabs):
        fail("attach failed (browser_requires_setup means the existing-profile "
             "grant path is needed — see NOTES.md)", raw2)
    STATE["contexts"][CTX] = {
        "session": session_label(), "owned": False, "prepared_pid": int(pid),
        "window_id": int(window_id), "target_id": d2["target_id"],
        "tabs": tabs, "active_tab": tabs[0]["tab_id"],
        "last_snap": None, "url": tabs[0].get("url"), "title": tabs[0].get("title")}
    save_state(STATE)
    print("attached: target=%s tabs=%d (NOT owned — close will not kill it)"
          % (d2["target_id"], len(tabs)))


def cmd_snap(full=False, query=None, more=None, scope=None):
    c = ctx(STATE)
    d = snap(c, query=query, cont=more, scope=scope)
    if full:
        print(json.dumps(d, indent=1))
    else:
        brief(d, limit=200)
        if d.get("content_refs"):
            print("content_refs:", json.dumps(d["content_refs"])[:1500])
    cont = (d.get("snapshot") or {}).get("continuation")
    if cont:
        print("SNAPSHOT TRUNCATED (node budget) — continue: "
              "browse snap --more %s ; or narrow: --scope <ref>" % cont)


def cmd_find(text):
    c = ctx(STATE)
    d = snap(c, query=text)
    hits = d.get("content_refs") or []
    print("%d content match(es) for '%s'" % (len(hits), text))
    for h in hits[:20]:
        print(" ", json.dumps(h)[:220])
    t = text.lower()
    for r in (d.get("refs") or []):
        if t in (r.get("name") or "").lower():
            print("  actionable: %s %s '%s' %s" % (r.get("ref"), r.get("role"),
                  r.get("name"), ",".join(r.get("actions") or [])))


def cmd_click(target, wait=None):
    c = ctx(STATE)
    ref = resolve(c, target, "click")
    click_like(dict(base(c), ref=ref), c, wait=wait)


def cmd_type(target, text, replace=False, wait=None, keystrokes=False):
    c = ctx(STATE)
    ref = resolve(c, target, "type")
    a = dict(base(c), ref=ref, text=text)
    if replace:
        a["replace"] = True
    if keystrokes:
        a["mode"] = "keystrokes"
    d, raw = cli("browser_type", a)
    eff = (d or {}).get("effect")
    if eff == "refused":
        fail("type refused", raw)
    print("type: effect=%s" % eff)
    d2 = wait_for(c, wait, 15) if wait else snap(c)
    hit = next((r for r in d2.get("refs") or []
                if text and text in (r.get("value") or "")), None)
    pg = d2.get("page") or {}
    if hit:
        print("field now holds value=%s" % json.dumps(hit.get("value")))
    if (pg.get("url") or "") != (c.get("url") or ""):
        pass
    print("now: %s" % pg.get("url"))


KEYS = {"enter": "\r", "return": "\r", "tab": "\t", "escape": "\x1b",
        "esc": "\x1b", "backspace": "\x08", "delete": "\x7f", "space": " "}


def cmd_press(key, target=None):
    """Send a real key event (keystrokes mode) into an editable ref.

    Enter submits forms / triggers default buttons where a keydown handler
    listens; Tab moves focus. TARGET names the field (or resolves to the
    single editable on the page when omitted)."""
    c = ctx(STATE)
    ch = KEYS.get(key.lower())
    if ch is None:
        fail("unknown key '%s' — known: %s" % (key, ", ".join(sorted(KEYS))))
    ref = resolve(c, target, "type") if target else \
        resolve(c, "\x00", "type")  # no-name match -> single-editable fallback
    d, raw = cli("browser_type", dict(base(c), ref=ref, text=ch,
                                    mode="keystrokes"))
    eff = (d or {}).get("effect")
    if eff == "refused":
        fail("key refused", raw)
    before = c.get("url")
    d2 = snap(c)
    pg = d2.get("page") or {}
    print("press %s: effect=%s" % (key, eff))
    if pg.get("url") != before:
        print("navigated -> %s" % pg.get("url"))


def cmd_files(target, paths):
    c = ctx(STATE)
    try:
        ref = resolve(c, target, "upload")
    except SystemExit:
        ref = resolve(c, target, "click")  # file inputs without the action
    for p in paths:
        if not os.path.isfile(p) or os.path.islink(p):
            fail("not a regular file: %s" % p)
    d, raw = cli("browser_set_input_files",
                 dict(base(c), ref=ref, files=[os.path.abspath(p) for p in paths]))
    print(json.dumps(d or raw)[:600])


def cmd_pointer(action, target=None, dx=None, dy=None, to=None):
    c = ctx(STATE)
    a = dict(base(c), action=action)
    if target:
        m = re.fullmatch(r"([\d.]+),([\d.]+)", target)
        if m:
            a["x"], a["y"] = float(m.group(1)), float(m.group(2))
        else:
            a["ref"] = resolve(c, target, "pointer")
    if dx is not None:
        a["delta_x"] = float(dx)
    if dy is not None:
        a["delta_y"] = float(dy)
    if to:
        m = re.fullmatch(r"([\d.]+),([\d.]+)", to)
        if m:
            a["to_x"], a["to_y"] = float(m.group(1)), float(m.group(2))
        else:
            a["destination_ref"] = resolve(c, to, "pointer")
    if "ref" not in a and action == "scroll":
        a["x"], a["y"] = 400, 400
    d, raw = cli("browser_pointer", a)
    eff = (d or {}).get("effect")
    if eff == "refused" and ((d or {}).get("escalation") or {}).get("reason") == "route_unavailable" and "ref" in a:
        a["input_route"] = "dom_event"
        d, raw = cli("browser_pointer", a)
        eff = (d or {}).get("effect")
    print("%s: effect=%s route=%s" % (action, eff, (d or {}).get("route")))
    if eff == "refused":
        fail("pointer refused", raw)


def cmd_shot(path=None, full=False):
    c = ctx(STATE)
    if full:
        cdp_shot_full(c, path)
        return
    d = snap(c, shot=True)
    b64 = d.get("screenshot_png_b64")
    if not b64:
        fail("no screenshot_png_b64 in response")
    path = path or os.path.join(os.environ.get("TMPDIR", "/tmp"),
                                "cua-browse-%s-%d.png" % (CTX, int(time.time())))
    open(path, "wb").write(b64decode(b64))
    print(path)
    sc = d.get("screenshot") or {}
    sx, sy = sc.get("pixel_to_css_scale_x"), sc.get("pixel_to_css_scale_y")
    if sx and sy and (sx != 1 or sy != 1):
        print("png px -> css px scale: x=%.3f y=%.3f (divide measured PNG "
              "coords by this to get x,y for pointer/drag calls)" % (sx, sy))


def cdp_shot_full(c, path):
    """Full-page PNG: Page.captureScreenshot with captureBeyondViewport over
    the instance's own DevTools endpoint (the driver's include_screenshot is
    viewport-only)."""
    _, pages = cdp_pages(c)
    page = next((t for t in pages if t.get("url") == c.get("url")),
                pages[0])
    msg = ws_rpc(page["webSocketDebuggerUrl"],
                 {"id": 1, "method": "Page.captureScreenshot",
                  "params": {"format": "png", "captureBeyondViewport": True}})
    data = (msg.get("result") or {}).get("data")
    if not data:
        fail("captureScreenshot failed", json.dumps(msg)[:400])
    path = path or os.path.join(os.environ.get("TMPDIR", "/tmp"),
                                "cua-browse-%s-%d.png" % (CTX, int(time.time())))
    open(path, "wb").write(b64decode(data))
    print(path)


