def cmd_eval(js):
    """Run page JS on the active tab. Tries the driver's execute_javascript
    first; on its standard-mode refusal, falls back transparently to
    Runtime.evaluate over the instance's own DevTools endpoint. Agents see
    one command either way. Prefix the argument with @ to read JS from a
    file (avoids shell-quoting pain on multi-line probes)."""
    c = ctx(STATE)
    if js.startswith("@"):
        js = open(js[1:], encoding="utf-8").read()
    d, raw = cli("page", {"action": "execute_javascript", "pid": c["prepared_pid"],
                          "window_id": c["window_id"], "javascript": js})
    refused = (d or {}).get("status") == "refused" or "refus" in (raw or "")[:200]
    if refused:
        cdp_eval(c, js)
        return
    print(raw)


def cdp_discover(c):
    """Discover the prepared instance's DevTools endpoint. Returns
    (http_port, browser_ws_url, [page-target dicts]) or fails."""
    p = subprocess.run(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN",
                        "-a", "-p", str(c["prepared_pid"])],
                       capture_output=True, text=True)
    ports = re.findall(r"127\.0\.0\.1:(\d+)\s+\(LISTEN\)", p.stdout or "")
    for port in dict.fromkeys(ports):
        try:
            with urllib.request.urlopen(
                    "http://127.0.0.1:%s/json" % port, timeout=3) as r:
                targets = json.loads(r.read())
            pages = [t for t in targets if t.get("type") == "page"]
            if not pages:
                continue
            with urllib.request.urlopen(
                    "http://127.0.0.1:%s/json/version" % port, timeout=3) as r:
                ver = json.loads(r.read())
            return int(port), ver.get("webSocketDebuggerUrl"), pages
        except Exception:
            continue
    fail("no DevTools endpoint on pid %s" % c["prepared_pid"])


def cdp_pages(c):
    port, _, pages = cdp_discover(c)
    return port, pages


def ws_rpc(ws_url, message, timeout=15):
    """Minimal stdlib WebSocket client — one JSON-RPC call over DevTools.
    Sends `message` (dict), ignores events, returns the matching reply."""
    m = re.match(r"ws://([^/]+)(/.*)$", ws_url)
    host, port = m.group(1).split(":")
    s = socket.create_connection((host, int(port)), timeout=timeout)
    key = b64encode(os.urandom(16)).decode()
    s.sendall(("GET %s HTTP/1.1\r\nHost: %s:%s\r\nUpgrade: websocket\r\n"
               "Connection: Upgrade\r\nSec-WebSocket-Key: %s\r\n"
               "Sec-WebSocket-Version: 13\r\n\r\n"
               % (m.group(2), host, port, key)).encode())
    buf = b""
    while b"\r\n\r\n" not in buf:
        chunk = s.recv(4096)
        if not chunk:
            fail("WS handshake closed", ws_url)
        buf += chunk
    head, buf = buf.split(b"\r\n\r\n", 1)
    if b" 101" not in head.split(b"\r\n")[0]:
        fail("WS handshake refused", head.decode(errors="replace")[:200])
    data = json.dumps(message).encode()
    mask = os.urandom(4)
    hdr = bytearray([0x81])
    n = len(data)
    if n < 126:
        hdr.append(0x80 | n)
    elif n < 65536:
        hdr += struct.pack(">B", 0x80 | 126) + struct.pack(">H", n)
    else:
        hdr += struct.pack(">B", 0x80 | 127) + struct.pack(">Q", n)
    s.sendall(bytes(hdr) + mask +
              bytes(b ^ mask[i % 4] for i, b in enumerate(data)))

    def read_exact(k):
        nonlocal buf
        while len(buf) < k:
            chunk = s.recv(65536)
            if not chunk:
                fail("WS closed mid-frame")
            buf += chunk
        out, buf = buf[:k], buf[k:]
        return out

    while True:  # read frames until a complete text message arrives
        b1, b2 = read_exact(2)
        fin, op = b1 & 0x80, b1 & 0x0F
        ln = b2 & 0x7F
        if ln == 126:
            ln = struct.unpack(">H", read_exact(2))[0]
        elif ln == 127:
            ln = struct.unpack(">Q", read_exact(8))[0]
        if b2 & 0x80:
            mkey = read_exact(4)
            payload = bytes(x ^ mkey[i % 4] for i, x in enumerate(read_exact(ln)))
        else:
            payload = read_exact(ln)
        if op == 0x9:  # ping -> pong
            s.sendall(b"\x8a\x80" + os.urandom(4))
            continue
        if op == 0x8:
            fail("WS closed by server")
        if op in (0x0, 0x1) and payload:
            try:
                msg = json.loads(payload)
            except Exception:
                continue
            if msg.get("id") == message.get("id"):
                s.close()
                return msg


def cdp_eval(c, js):
    """Runtime.evaluate on the ctx's active page via the DevTools endpoint —
    the fallback when the gated `execute_javascript` tool refuses."""
    _, pages = cdp_pages(c)
    page = next((t for t in pages if t.get("url") == c.get("url")),
                pages[0])
    msg = ws_rpc(page["webSocketDebuggerUrl"],
                 {"id": 1, "method": "Runtime.evaluate",
                  "params": {"expression": js, "returnByValue": True,
                             "awaitPromise": True}})
    res = (msg.get("result") or {})
    if "exceptionDetails" in res:
        fail("page JS threw",
             json.dumps(res["exceptionDetails"])[:600])
    print(json.dumps((res.get("result") or {}).get("value"),
                     ensure_ascii=False))


def cmd_cdp():
    """Print the isolated instance's DevTools endpoint and page WS URLs —
    the escape hatch for external CDP tooling (playwright connectOverCDP,
    custom WS scripts). The port is ephemeral (--remote-debugging-port=0);
    this discovers it from the pid."""
    c = ctx(STATE)
    port, bws, pages = cdp_discover(c)
    print("http http://127.0.0.1:%s  (e.g. playwright connectOverCDP)" % port)
    print("browser ws %s" % bws)
    for t in pages:
        print("page %s\n  ws %s" % (t.get("url"), t.get("webSocketDebuggerUrl")))



def cmd_read(target):
    """Print one element's role/name/value/states — the way to extract a
    generated code, field value, or label (e.g. a /listen/<code> on screen)."""
    c = ctx(STATE)
    ref = resolve(c, target, "any")
    r = next((x for x in LAST_D.get("refs") or []
              if x.get("ref") == ref), None)
    if not r:
        fail("ref %s not in snapshot" % ref)
    print(json.dumps({k: r[k] for k in
                      ("ref", "role", "name", "value", "states", "actions")
                      if r.get(k) is not None}, ensure_ascii=False))


def cmd_copy(target=None):
    """Copy page text (or one element's value/name) to the macOS clipboard —
    the sanctioned 'copy' path: no text selection needed."""
    c = ctx(STATE)
    if target:
        ref = resolve(c, target, "any")
        r = next((x for x in LAST_D.get("refs") or []
                  if x.get("ref") == ref), None)
        txt = ((r or {}).get("value") or (r or {}).get("name"))
        if txt is None:
            fail("element has no value/name to copy")
    else:
        d, raw = cli("page", {"action": "get_text", "pid": c["prepared_pid"],
                              "window_id": c["window_id"]})
        txt = ((d or {}).get("text")
               or re.sub(r"^\s+|\s+$", "", raw or ""))
        if not txt:
            fail("no page text", raw)
    d, raw = cli("clipboard_write", {"text": txt})
    if (d or {}).get("status") == "refused" or d is None and "refus" in raw:
        fail("clipboard_write refused", raw)
    d2, _ = cli("clipboard_read", {"include_text": True})
    got = (d2 or {}).get("text") or ""
    print("copied %d chars; clipboard verified: %r" %
          (len(txt), got[:120] + ("..." if len(got) > 120 else "")))


def cmd_download(target, outdir):
    """Trigger a download through a clickable ref into an exact directory.
    Gated tool — may require MCP-host approval; refusal is printed, not hidden."""
    c = ctx(STATE)
    ref = resolve(c, target, "click")
    outdir = os.path.realpath(os.path.abspath(os.path.expanduser(outdir)))
    os.makedirs(outdir, exist_ok=True)
    d, raw = cli("browser_download",
                 dict(base(c), ref=ref, destination_root=outdir))
    print(json.dumps(d or raw, indent=1)[:1200])
    if (d or {}).get("status") == "refused":
        fail("download refused (gated: needs destination approval)", raw)


