def cmd_tabs():
    c = ctx(STATE)
    d, raw = cli("get_browser_state",
                 {"pid": c["prepared_pid"], "window_id": c["window_id"]})
    tabs = (d or {}).get("tabs") or []
    if not tabs:
        fail("tab refresh failed", raw)
    # re-bind re-mints tab ids; carry the active selection over by url/title
    prev = next((t for t in c.get("tabs") or []
                 if t.get("tab_id") == c.get("active_tab")), {})
    c["tabs"] = tabs
    match = next((t for t in tabs if t["tab_id"] == c.get("active_tab")), None) \
        or next((t for t in tabs if t.get("url") and t.get("url") == prev.get("url")), None) \
        or tabs[0]
    c["active_tab"] = match["tab_id"]
    save_state(STATE)
    for i, t in enumerate(tabs):
        mark = "*" if t["tab_id"] == c["active_tab"] else " "
        print("%s [%d] %s %s | %s" % (mark, i, t["tab_id"], t.get("title"), t.get("url")))


def cmd_tab(sel):
    c = ctx(STATE)
    cmd_tabs()
    tabs = c["tabs"]
    pick = None
    if sel.isdigit() and int(sel) < len(tabs):
        pick = tabs[int(sel)]
    else:
        for t in tabs:
            if t["tab_id"] == sel or sel in (t.get("url") or "") or sel in (t.get("title") or ""):
                pick = t
                break
    if not pick:
        fail("no tab matching '%s'" % sel)
    c["active_tab"] = pick["tab_id"]
    c["last_snap"] = None
    save_state(STATE)
    print("active tab -> %s | %s" % (pick["tab_id"], pick.get("url")))


def cmd_resize(w, h):
    c = ctx(STATE)
    d, raw = cli("list_windows", {"pid": c["prepared_pid"], "on_screen_only": True})
    ws = (d or {}).get("windows") or []
    win = next((x for x in ws if x.get("window_id") == c["window_id"]), ws[0] if ws else None)
    if not win:
