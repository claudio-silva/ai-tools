    b = win["bounds"]
    d, raw = cli("set_window_frame",
                 {"pid": c["prepared_pid"], "window_id": c["window_id"],
                  "x": b["x"], "y": b["y"], "width": float(w), "height": float(h)})
    print(json.dumps(d or raw)[:500])
    print("(outer frame set — viewport = frame minus browser chrome; verify via snap/shot)")


def cmd_record(sub, outdir=None, video=False):
    if sub == "start":
        outdir = outdir or os.path.join(
            os.environ.get("TMPDIR", "/tmp"), "cua-browse-rec-%s" % CTX)
        outdir = os.path.abspath(os.path.expanduser(outdir))
