#!/usr/bin/env python3
"""Install, update, uninstall, and list tools from this repository."""

from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

BIN_DIR = Path(__file__).resolve().parent
if str(BIN_DIR) not in sys.path:
    sys.path.insert(0, str(BIN_DIR))

from common import (  # noqa: E402
    CLONE_URL,
    PLATFORM_ORDER,
    REPO_ROOT,
    SCRIPT_PATH,
    SkillError,
    die,
    display,
    display_link,
    entry_kind,
    home,
    installed_scopes,
    load_state,
    render_installed,
    require_macos_arm,
    selected_platforms,
)
import mcp as mcp_cmds  # noqa: E402
import skills as skill_cmds  # noqa: E402

HELP = """\
Manage this repository's tools for Cursor, Codex, Claude Code, and Devin.
A tool is a skill or an MCP server.

List, install, update, or remove tools, or get information about the provided ones.

Commands:
  install [tool...]      Install tools. Defaults to --global.
  update [tool...]       Reinstall installed tools whose repository copy is newer.
                         No names, or --all, updates every outdated install.
                         Defaults to --global. Uninstalls, then installs.
  uninstall [tool...]    Remove tools this command installed. Defaults to --global.
  list [tool...]         List tools in this repository, grouped by platform.
  installed [tool...]    List tools installed on each platform.
                         Defaults to both global and local.
  about|info|show <tool> Show information about a tool, including install
                         status (◉ managed, ◎ other, ▲ update, or not installed).
  mcp <command>          MCP-only form of those commands. install and update
                         also take --raw.
  pull                   Updates the local tools repository to the latest online version.
  setup                  Installs or removes this command globally, for easy access.
  help                   (or --help) Show this help.

Options:
  -g, --global           User-level directories. Default for install, update,
                         and uninstall. Combine with --local to use both scopes.
                         For installed, show the user-level directories.
  -l, --local            Project directories. Combine with --global to use
                         both scopes. For installed, show the project.
  -C, --directory DIR    Project directory for --local. Default: current directory.
  -p, --platform NAME    cursor, codex, claude-code, or devin. Repeat the flag,
                         or pass a comma-separated list.
  -a, --all              install: every matching tool in the repo. update:
                         every outdated install. uninstall: every recorded
                         install for the selected scope and platforms.
  -n, --dry-run          Show what install, update, or uninstall would change.
  --version              With installed, append each tool's version.
  --raw                  With install or update, write MCP $NAME placeholders
                         instead of filling them from the environment.
  -h, --help             Show this help.

setup options:
  --remove               Remove ~/bin/aitools or ~/.local/bin/aitools when it
                         links to this script.

Install locations:

  Skills
  Platform      Global                    Local
  cursor        ~/.cursor/skills          .cursor/skills
  codex         $CODEX_HOME/skills        .agents/skills
  claude-code   ~/.claude/skills          .claude/skills
  devin         ~/.config/devin/skills    .devin/skills

  MCP configs
  Platform      Global                         Local
  cursor        ~/.cursor/mcp.json             .cursor/mcp.json
  codex         $CODEX_HOME/config.toml        .codex/config.toml
  claude-code   ~/.claude.json                 .mcp.json
  devin         ~/.config/devin/mcp_config.json .devin/mcp_config.json

Notes:
  installed displays:
    ◎ for 3rd party tools,
    ◉ for tools managed by this installer,
    ▲ for managed tools that can be updated.
  Version numbers have the vYYMMDDHHmm format, which is derived from the tool
  files' modification time (whichever file is newer).
  $CODEX_HOME defaults to ~/.codex
  MCP installation supports scripting languages or macOS Apple Silicon binaries.

Examples:
  aitools setup
  aitools list
  aitools list --platform cursor --local
  aitools show imagen
  aitools installed
  aitools installed --version
  aitools install --all
  aitools install imagen
  aitools install imagen --raw  #doesn't fill in API keys, etc.
  aitools install removebg-cli --platform cursor
  aitools uninstall auto-routing
  aitools update
  aitools update imagen
  aitools pull
  aitools setup --remove

For detailed information about all tools, read ABOUT_PATH
"""


def git_commit() -> str:
    git = shutil.which("git")
    if git is None or not (REPO_ROOT / ".git").exists():
        return ""
    result = subprocess.run(
        [git, "-C", str(REPO_ROOT), "rev-parse", "--short", "HEAD"],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return ""
    return result.stdout.strip()


def cmd_pull() -> int:
    if not (REPO_ROOT / ".git").exists():
        die(
            f"{display(REPO_ROOT)} is not a git clone, so there is no history to update. "
            f"Clone {CLONE_URL} and symlink bin/aitools onto your PATH."
        )
    git = shutil.which("git")
    if git is None:
        die("git is required to update this repository")
    before = git_commit()
    print(f"repository  {display(REPO_ROOT)}")
    if before:
        print(f"commit      {before}")
    result = subprocess.run([git, "-C", str(REPO_ROOT), "pull"], check=False)
    after = git_commit()
    if result.returncode == 0 and after and after != before:
        print(f"commit      {after}")
    return result.returncode


def setup_dirs() -> list[Path]:
    root = home()
    return [root / "bin", root / ".local" / "bin"]


def path_dir_on_path(directory: Path) -> bool:
    try:
        resolved = directory.expanduser().resolve()
    except OSError:
        return False
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        if not entry:
            continue
        try:
            if Path(entry).expanduser().resolve() == resolved:
                return True
        except OSError:
            continue
    return False


def aitools_on_path() -> Path | None:
    found = shutil.which("aitools")
    if found is None:
        return None
    return Path(found)


def setup_link_for(found: Path) -> Path | None:
    absolute = found if found.is_absolute() else Path.cwd() / found
    try:
        parent = absolute.parent.resolve()
    except OSError:
        return None
    for directory in setup_dirs():
        try:
            if parent != directory.resolve():
                continue
        except OSError:
            continue
        link = directory / "aitools"
        if link.is_symlink() and link.resolve() == SCRIPT_PATH:
            return link
    return None


def warn_if_shadowed(link: Path) -> None:
    found = aitools_on_path()
    installed = setup_link_for(found) if found is not None else None
    if installed == link:
        return
    other = display_link(found) if found is not None else "not found"
    print(f"note: aitools on PATH is {other}, so {display_link(link)} is hidden")


def cmd_setup(remove: bool) -> None:
    script = SCRIPT_PATH
    links = [directory / "aitools" for directory in setup_dirs()]
    if remove:
        removed = False
        for link in links:
            if not link.is_symlink() or link.resolve() != script:
                continue
            link.unlink()
            print(f"removed {display_link(link)}")
            removed = True
        if not removed:
            places = " or ".join(display_link(link.parent) for link in links)
            die(f"no link to this script in {places}")
        return

    found = aitools_on_path()
    installed = setup_link_for(found) if found is not None else None
    if installed is not None:
        print(f"already set up: {display_link(installed)} -> {display(script)}")
        return

    available = [directory for directory in setup_dirs() if path_dir_on_path(directory)]
    if not available:
        die(
            "~/bin and ~/.local/bin are not on PATH. "
            "Create one of them, add it to PATH, and run setup again."
        )

    skipped: list[str] = []
    for directory in available:
        link = directory / "aitools"
        if link.is_symlink():
            target = link.resolve()
            if target == script:
                print(f"already linked: {display_link(link)} -> {display(script)}")
                warn_if_shadowed(link)
                return
            skipped.append(f"{display_link(link)} links to {display(target)}")
            continue
        if link.exists():
            skipped.append(f"{display_link(link)} exists and is not a symlink")
            continue
        if not directory.is_dir():
            if directory.exists():
                skipped.append(f"{display_link(directory)} exists and is not a directory")
                continue
            try:
                directory.mkdir(parents=True, exist_ok=True)
            except OSError as exc:
                skipped.append(f"could not create {display_link(directory)}: {exc}")
                continue
        if not os.access(directory, os.W_OK):
            skipped.append(f"{display_link(directory)} is not writable")
            continue
        try:
            link.symlink_to(script)
        except OSError as exc:
            skipped.append(f"could not create {display_link(link)}: {exc}")
            continue
        print(f"linked {display_link(link)} -> {display(script)}")
        warn_if_shadowed(link)
        return
    die("could not install aitools: " + "; ".join(skipped))


def add_scope_flags(command: argparse.ArgumentParser, *, names: str = "skills") -> None:
    command.add_argument(names, nargs="*")
    command.add_argument("-g", "--global", dest="scope_global", action="store_true")
    command.add_argument("-l", "--local", action="store_true")
    command.add_argument("-C", "--directory", type=Path)
    command.add_argument("-p", "--platform", action="append", default=[])
    command.add_argument("-a", "--all", action="store_true")
    command.add_argument("-n", "--dry-run", action="store_true")
    command.add_argument("-h", "--help", action="store_true")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="aitools", add_help=False)
    parser.add_argument("-h", "--help", action="store_true")
    sub = parser.add_subparsers(dest="command")
    for name in ("install", "uninstall", "list", "installed", "update", "pull"):
        command = sub.add_parser(name, add_help=False)
        add_scope_flags(command)
        if name == "installed":
            command.add_argument("--version", action="store_true")
        if name in ("install", "update"):
            command.add_argument("--raw", action="store_true")
    for name in ("about", "info", "show"):
        add_scope_flags(sub.add_parser(name, add_help=False))
    mcp = sub.add_parser("mcp", add_help=False)
    mcp.add_argument("-h", "--help", action="store_true")
    mcp_sub = mcp.add_subparsers(dest="mcp_command")
    for name in ("install", "uninstall", "list", "installed", "update"):
        command = mcp_sub.add_parser(name, add_help=False)
        add_scope_flags(command, names="names")
        if name == "installed":
            command.add_argument("--version", action="store_true")
        if name in ("install", "update"):
            command.add_argument("--raw", action="store_true")
    for name in ("about", "info", "show"):
        add_scope_flags(mcp_sub.add_parser(name, add_help=False), names="names")
    setup = sub.add_parser("setup", add_help=False)
    setup.add_argument("--remove", dest="setup_remove", action="store_true")
    setup.add_argument("-h", "--help", action="store_true")
    sub.add_parser("help", add_help=False)
    return parser


HELP_HEADINGS = {
    "Commands:",
    "Options:",
    "setup options:",
    "Install locations:",
    "Notes:",
    "Examples:",
}
COMMAND_NAMES = {
    "install",
    "update",
    "uninstall",
    "list",
    "installed",
    "about",
    "info",
    "show",
    "mcp",
    "pull",
    "setup",
    "help",
}


def argparse_theme():
    try:
        from _colorize import can_colorize, get_theme
    except ImportError:
        return None
    if not can_colorize(file=sys.stdout):
        return None
    return get_theme(force_color=True).argparse


def color_flags(text: str, theme) -> str:
    parts = []
    for token in text.split(", "):
        if token.startswith("--"):
            parts.append(f"{theme.long_option}{token}{theme.reset}")
        elif token.startswith("-"):
            parts.append(f"{theme.short_option}{token}{theme.reset}")
        else:
            parts.append(token)
    return ", ".join(parts)


def colorize_text(text: str) -> str:
    theme = argparse_theme()
    if theme is None:
        return text
    colored = []
    for line in text.splitlines(keepends=True):
        body = line[:-1] if line.endswith("\n") else line
        newline = "\n" if line.endswith("\n") else ""
        usage = re.match(r"^(Usage: |usage: )(\S+)(.*)$", body)
        if usage:
            colored.append(
                f"{theme.usage}{usage.group(1)}{theme.reset}"
                f"{theme.prog}{usage.group(2)}{theme.reset}"
                f"{theme.prog_extra}{usage.group(3)}{theme.reset}{newline}"
            )
            continue
        if body in HELP_HEADINGS:
            colored.append(f"{theme.heading}{body}{theme.reset}{newline}")
            continue
        command = re.match(r"^(  )([a-z][\w-]*)(.*)$", body)
        if command and command.group(2) in COMMAND_NAMES:
            colored.append(
                f"{command.group(1)}{theme.action}{command.group(2)}{theme.reset}"
                f"{command.group(3)}{newline}"
            )
            continue
        option = re.match(r"^(  )(-.*)(\s{2,}.*)$", body)
        if option:
            colored.append(
                f"{option.group(1)}{color_flags(option.group(2), theme)}"
                f"{option.group(3)}{newline}"
            )
            continue
        example = re.match(r"^(  )(aitools)(.*)$", body)
        if example:
            colored.append(
                f"{example.group(1)}{theme.prog}{example.group(2)}{theme.reset}"
                f"{example.group(3)}{newline}"
            )
            continue
        about = "For detailed information about all tools, read "
        if body.startswith(about):
            path = body[len(about):].removesuffix(".")
            period = "." if body.endswith(".") else ""
            colored.append(f"{about}\x1b[34m{path}{theme.reset}{period}{newline}")
            continue
        if body.startswith("installed displays:"):
            colored.append(f"{theme.summary_action}installed{theme.reset}{body[len('installed'):]}{newline}")
            continue
        if re.fullmatch(r"  (Skills|MCP configs)", body):
            colored.append(f"{theme.heading}{body}{theme.reset}{newline}")
            continue
        if re.fullmatch(r"  Platform\s+Global\s+Local", body):
            colored.append(f"\x1b[1m{body}{theme.reset}{newline}")
            continue
        colored.append(line)
    return "".join(colored)


def show_help() -> None:
    text = HELP.replace("ABOUT_PATH", str(REPO_ROOT / "ABOUT.md"))
    print(build_parser().format_usage(), end="")
    print()
    print(colorize_text(text), end="")


def narrowed(args: argparse.Namespace, names: list[str], *, use_all: bool) -> argparse.Namespace:
    view = argparse.Namespace(**vars(args))
    view.skills = list(names)
    view.names = list(names)
    view.all = use_all
    return view


def partition_tools(names: list[str], skills: list, servers: list, state: dict, *, receipts: bool) -> tuple[list[str], list[str]]:
    repo_skills = {skill.name for skill in skills}
    repo_mcps = {server.name for server in servers}
    known_skills = set(repo_skills)
    known_mcps = set(repo_mcps)
    if receipts:
        for entry in state["installs"]:
            if entry_kind(entry) == "mcp" and entry.get("name"):
                known_mcps.add(entry["name"])
            elif entry_kind(entry) == "skill" and entry.get("skill"):
                known_skills.add(entry["skill"])
    skill_names: list[str] = []
    mcp_names: list[str] = []
    unknown: list[str] = []
    both: list[str] = []
    for name in names:
        in_skill = name in known_skills
        in_mcp = name in known_mcps
        if in_skill and in_mcp:
            both.append(name)
        elif in_skill:
            skill_names.append(name)
        elif in_mcp:
            mcp_names.append(name)
        else:
            unknown.append(name)
    if both:
        die(", ".join(both) + " matches both a skill and an MCP server")
    if unknown:
        die("unknown tool: " + ", ".join(unknown))
    return skill_names, mcp_names


def cmd_list_tools(args: argparse.Namespace, skills: list, servers: list) -> None:
    platform_filter = selected_platforms(args.platform)
    name_filter = set(args.skills)
    platforms = platform_filter or list(PLATFORM_ORDER)
    for platform in platforms:
        print(platform)
        rows = []
        for skill in skills:
            if platform in skill.platforms and (not name_filter or skill.name in name_filter):
                rows.append(skill.name)
        for server in servers:
            if platform in server.platforms and (not name_filter or server.name in name_filter):
                rows.append(f"{server.name}  (mcp)")
        rows.sort(key=lambda row: row.split()[0])
        if not rows:
            print("  (none)")
        else:
            for row in rows:
                print(f"  {row}")
        print()


def wants_help(argv: list[str]) -> bool:
    for arg in argv:
        if arg == "--":
            break
        if arg in ("-h", "--help"):
            return True
    return False


def main(argv: list[str]) -> int:
    if wants_help(argv):
        show_help()
        return 0
    parser = build_parser()
    try:
        args = parser.parse_args(argv)
    except SystemExit as exc:
        return int(exc.code or 0)
    if args.command == "help":
        show_help()
        return 0
    if args.command is None:
        print(parser.format_usage(), end="")
        return 1
    if args.command in ("info", "show"):
        args.command = "about"
    try:
        require_macos_arm()
        if args.command == "pull":
            skill_cmds.require_skill_args(args, args.command)
            return cmd_pull()
        if args.command == "setup":
            skill_cmds.require_skill_args(args, args.command)
            cmd_setup(getattr(args, "setup_remove", False))
            return 0
        if args.command == "mcp":
            mcp_cmds.dispatch(args)
            return 0
        skill_cmds.require_skill_args(args, args.command)
        skills = skill_cmds.discover_skills()
        servers = mcp_cmds.discover_mcps()
        state = load_state()
        receipts = args.command in ("uninstall", "installed")
        skill_names, mcp_names = partition_tools(
            args.skills, skills, servers, state, receipts=receipts
        )
        if getattr(args, "raw", False) and not args.all and not mcp_names:
            die("--raw applies to MCP servers")
        if args.command == "about":
            if mcp_names:
                mcp_args = narrowed(args, mcp_names, use_all=False)
                mcp_cmds.cmd_about(mcp_args, servers, state)
            else:
                skill_cmds.cmd_about(narrowed(args, skill_names, use_all=False), skills, state)
        elif args.command == "list":
            list_args = narrowed(args, skill_names + mcp_names, use_all=False)
            cmd_list_tools(list_args, skills, servers)
        elif args.command == "installed":
            scopes, project = installed_scopes(args)
            sections = []
            if not args.skills or skill_names:
                view = narrowed(args, skill_names, use_all=False)
                sections.append(("Skills", skill_cmds.collect_installed(view, skills, state, scopes, project)))
            if not args.skills or mcp_names:
                view = narrowed(args, mcp_names, use_all=False)
                sections.append(("MCP servers", mcp_cmds.collect_installed(view, servers, state, scopes, project)))
            render_installed(sections, scopes, project)
        elif args.command == "install":
            if args.all or skill_names:
                skill_cmds.cmd_install(
                    narrowed(args, skill_names, use_all=args.all), skills, state, allow_empty=args.all
                )
            if args.all or mcp_names:
                mcp_cmds.cmd_install(
                    narrowed(args, mcp_names, use_all=args.all), servers, state, allow_empty=args.all
                )
        elif args.command == "update":
            changed = False
            if args.all or not args.skills or skill_names:
                changed = skill_cmds.cmd_update(
                    narrowed(args, skill_names, use_all=args.all), skills, state, allow_empty=True
                ) or changed
            if args.all or not args.skills or mcp_names:
                changed = mcp_cmds.cmd_update(
                    narrowed(args, mcp_names, use_all=args.all), servers, state, allow_empty=True
                ) or changed
            if not changed and (args.all or not args.skills):
                print("nothing to update")
        elif args.command == "uninstall":
            if args.all or skill_names:
                skill_cmds.cmd_uninstall(
                    narrowed(args, skill_names, use_all=args.all), skills, state, allow_empty=args.all
                )
            if args.all or mcp_names:
                mcp_cmds.cmd_uninstall(
                    narrowed(args, mcp_names, use_all=args.all), servers, state, allow_empty=args.all
                )
        else:
            die(f"unknown command {args.command}")
    except SkillError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print(file=sys.stderr)
        sys.exit(130)
